# Application
APP_NAME=Multi-Agent RAG Debugger
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# LLM. Use mock for offline development. openai, openrouter, and ollama require live services.
LLM_PROVIDER=mock
LLM_MODEL=openai/gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# Credentials. Leave empty when using LLM_PROVIDER=mock.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Embeddings. hash is deterministic for tests. local uses sentence-transformers. openai needs OPENAI_API_KEY.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

# Persistence
DATABASE_URL=sqlite:///./data/debugger.db

# Optional API bearer token. When empty, endpoints are open (local development only).
API_AUTH_TOKEN=
AUTH_MODE=optional
SESSION_TTL_HOURS=168
DEFAULT_WORKSPACE_ID=default
RERANKER=lexical

# Limits
MAX_UPLOAD_BYTES=15728640
MAX_DOCUMENTS_PER_KB=200
MAX_CHUNKS_PER_DOCUMENT=4000
MAX_CONTEXT_CHARS=12000
MAX_LLM_CALLS_PER_WORKFLOW=12
MAX_WORKFLOW_SECONDS=180
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_TOP_K=5

# Cost estimates used only when the provider does not return usage
USD_PER_1K_PROMPT_TOKENS=0.00015
USD_PER_1K_COMPLETION_TOKENS=0.0006

JOB_EXECUTION_MODE=inline
RATE_LIMIT_PER_MINUTE=0
MAX_EVALUATION_ITEMS=200

# CORS. Local Vite (5173) is already allowed. Production should set the real UI origin.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional GitHub clone (not OAuth). Used only for https://github.com/... clone.
GITHUB_TOKEN=

# Comma-separated folders the API may read. Empty = any path in development.
ALLOWED_REPO_ROOTS=
